APP_NAME="Sistema de Protocolo Interno"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://protocolo.exemplo.com
APP_TIMEZONE=America/Fortaleza

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Aumente o número de workers apenas se o servidor tiver memória suficiente.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# Em VPS com MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_protocolo
DB_USERNAME=protocolo
DB_PASSWORD=

# Em cPanel, quando não houver MySQL, use SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/para/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configure um servidor SMTP real em produção (recuperação de senha, notificações).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Proxies confiáveis (Nginx/balanceador). Use "*" para confiar em qualquer proxy.
# Necessário para o sistema detectar HTTPS e o IP real do cliente.
TRUSTED_PROXIES=*
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# Limite de upload de anexos (KB). Deve ser compatível com upload_max_filesize
# e post_max_size definidos no php.ini (por exemplo: 10 MB = 10240).
PROTOCOLO_MAX_UPLOAD_KB=10240

# Credenciais do Super Administrador criado pelo seeder (database/seeders/SuperAdminSeeder.php).
# Troque a senha após o primeiro acesso.
SUPER_ADMIN_EMAIL=superadmin@protocolo.local
SUPER_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
